{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devflow/decision.schema.json",
  "title": "Decision",
  "description": "Planner 의 출력. 다섯 가지 중 하나만 고를 수 있고, 실행은 시스템이 한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "task_id", "action", "rationale", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "task_id": { "type": "string" },
    "after_step": { "type": ["string", "null"], "description": "이 결정 직전에 끝난 Step. 첫 결정이면 null." },
    "action": { "enum": ["next_step", "rework", "ask_human", "done", "abort"] },
    "rationale": { "type": "string", "description": "왜 이 행동인가. 사람이 읽고 납득할 수 있어야 한다." },
    "next_step": {
      "description": "action=next_step. Freeform 이면 step 에 전체 정의를, Skill 이면 skill+params 를 쓴다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step": { "type": "object", "description": "step.schema.json 에서 id/task_id/status 를 제외한 정의." },
        "skill": { "type": "string", "description": "name@version" },
        "params": { "type": "object" }
      },
      "oneOf": [{ "required": ["step"] }, { "required": ["skill"] }]
    },
    "rework": {
      "description": "action=rework. 대상 Step 과 무엇을 고쳐야 하는지.",
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "instructions"],
      "properties": {
        "step_id": { "type": "string" },
        "instructions": { "type": "string" }
      }
    },
    "question": {
      "description": "action=ask_human. 가능하면 선택지를 제시한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } }
      }
    },
    "completion": {
      "description": "action=done. AC 별 충족 근거가 필수이며, 사람이 최종 확정한다.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ac_id", "evidence"],
        "properties": {
          "ac_id": { "type": "string" },
          "evidence": { "type": "string", "description": "근거가 되는 Artifact/GateResult 참조와 설명." }
        }
      }
    },
    "human_edit": { "type": "string", "description": "Step 제안 확인 단계에서 사람이 수정했다면 그 내용 요약 (회고용)." },
    "planner_run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "action": { "const": "next_step" } } }, "then": { "required": ["next_step"] } },
    { "if": { "properties": { "action": { "const": "rework" } } }, "then": { "required": ["rework"] } },
    { "if": { "properties": { "action": { "const": "ask_human" } } }, "then": { "required": ["question"] } },
    { "if": { "properties": { "action": { "const": "done" } } }, "then": { "required": ["completion"] } }
  ]
}
