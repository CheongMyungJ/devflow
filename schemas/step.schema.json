{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devflow/step.schema.json",
  "title": "Step",
  "description": "Planner 가 하나씩 결정하는 작업 단위. Freeform 과 Skill 기반 Step 모두 이 스키마로 펼쳐진 뒤 같은 경로로 실행된다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "task_id", "goal", "scope", "inputs", "outputs", "done_when", "verify", "approval", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^step-[0-9]{3,}$" },
    "task_id": { "type": "string" },
    "skill": {
      "description": "Skill 에서 펼쳐진 Step 이면 'name@version', Freeform 이면 null. 기록 목적이며 실행 경로에는 영향이 없다.",
      "type": ["string", "null"]
    },
    "goal": { "type": "string", "description": "이 Step 이 무엇을 달성해야 하는가." },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" }, "description": "작업 대상 (repo 상대 경로, 모듈, 주제)." },
        "exclude": { "type": "array", "items": { "type": "string" }, "description": "하지 말아야 할 것 (예: '코드 수정 금지 — 분석만')." }
      }
    },
    "inputs": {
      "description": "시스템이 Context 패킷을 조립할 때 사용하는 참조 목록. 승인된 Artifact 버전만 참조할 수 있다.",
      "type": "array",
      "items": {
        "type": "string",
        "description": "'task.brief', 'task.ledger', 'artifact://T-0012/step-002/repro-report@v2', 'code://<repo>@<sha>' 등."
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["document", "code_change", "data"] },
          "description": { "type": "string" }
        }
      }
    },
    "done_when": {
      "description": "완료 조건. 검증 가능한 문장으로 쓴다.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "verify": {
      "description": "이 Step 에서 실행할 검증. 선언된 것만 실행된다. 둘 중 하나 이상은 비어 있지 않아야 한다 (ADR-0003).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "description": "시스템이 실행하는 검사. 코드 변경이 없는 Step 에 build/test 를 넣지 않는다.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "run"],
            "properties": {
              "name": { "type": "string" },
              "run": { "type": "string", "description": "명령, 또는 '.devflow.yaml' 에 정의된 명령의 이름 (예: '@build', '@test')." },
              "expect": { "enum": ["success", "failure"], "default": "success", "description": "버그 재현 테스트처럼 실패해야 통과인 경우 'failure'." }
            }
          }
        },
        "semantic": {
          "description": "Quality Reviewer(AI)가 판단할 질문 목록.",
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "anyOf": [
        { "required": ["deterministic"], "properties": { "deterministic": { "minItems": 1 } } },
        { "required": ["semantic"], "properties": { "semantic": { "minItems": 1 } } }
      ]
    },
    "approval": {
      "description": "required: 사람 승인 필수. optional: Gate 통과 시 자동 진행. deterministic 이 비어 있으면 시스템이 required 로 강제한다.",
      "enum": ["required", "optional"]
    },
    "status": {
      "enum": ["proposed", "defined", "running", "checking", "in_review", "revising", "approved", "closed", "cancelled"]
    },
    "rationale": { "type": "string", "description": "Planner 가 이 Step 을 선택한 이유." },
    "created_from": { "type": "string", "description": "이 Step 을 만든 Decision ID." }
  }
}
