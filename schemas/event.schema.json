{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devflow/event.schema.json",
  "title": "Event",
  "description": "Task 별 append-only 이벤트 로그(events.jsonl)의 한 줄. 상태의 기준 기록이며, 수정·삭제하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "task_id",
    "type",
    "actor",
    "at"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Task 내 순번. 동시성 제어와 재적재의 기준."
    },
    "task_id": {
      "type": "string"
    },
    "commit_id": {
      "description": "이 이벤트를 기록한 Store commit(commit, createTask 의 호출 하나)의 식별자. Store 가 commit 마다 하나를 만들어 그 commit 의 모든 이벤트에 같은 값을 넣는다 — 호출자는 주지 않는다. UUID 의 소문자 문자열이고 버전은 고정하지 않는다. 결과를 알 수 없는 commit 의 확인이 이 값으로 \"내 commit 인가\" 를 가린다(docs/design/commands.md 3절). 이 필드가 생기기 전의 이벤트와 0단계의 운영 스크립트가 쓴 이벤트에는 없다.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "description": "MVP 에서 사용하는 이벤트. 필요 시 추가한다.",
      "enum": [
        "task.created",
        "task.requirement_added",
        "task.done",
        "task.aborted",
        "decision.made",
        "decision.answered",
        "step.proposed",
        "step.defined",
        "step.status_changed",
        "step.cancelled",
        "run.submitted",
        "run.message_sent",
        "run.completed",
        "run.failed",
        "run.cancelled",
        "artifact.version_added",
        "artifact.approved",
        "feedback.added",
        "gate.completed",
        "ledger.updated",
        "workspace.prepare_requested",
        "workspace.prepared",
        "run.cancel_requested"
      ]
    },
    "actor": {
      "description": "누가 일으켰는가. human:<id>(사람, <id> 는 비어 있지 않다) | system | role:<intake|worker|reviewer|planner>(역할 세션). 모두 소문자 접두어다.",
      "type": "string",
      "pattern": "^(human:.+|system|role:(intake|worker|reviewer|planner))$"
    },
    "step_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "ref": {
      "type": "string",
      "description": "관련 엔티티 ID 또는 artifact ref."
    },
    "data": {
      "type": "object",
      "description": "이벤트별 부가 데이터 (예: status_changed 의 from/to)."
    },
    "system_sha": {
      "type": "string",
      "description": "실행 당시 devflow repo 의 commit SHA (프롬프트/스키마 버전 추적)."
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "workspace.prepare_requested"
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "workspace-preparation.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workspace.prepared"
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspace_id"
            ],
            "properties": {
              "workspace_id": {
                "type": "string",
                "format": "uuid",
                "description": "완료된 workspace.prepare_requested의 식별자."
              }
            }
          }
        }
      }
    }
  ]
}
