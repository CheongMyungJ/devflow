{
  "name": "devflow",
  "version": "0.0.0",
  "private": true,
  "description": "사람 + AI + 시스템이 함께 SW 개발 업무를 수행하는 시스템",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "validate-data": "node scripts/validate-data.mjs",
    "append-events": "node scripts/append-events.mjs",
    "propose-step": "node scripts/propose-step.mjs",
    "record-gate": "node scripts/record-gate.mjs",
    "submit-run": "node scripts/submit-run.mjs",
    "complete-run": "node scripts/complete-run.mjs",
    "fail-run": "node scripts/fail-run.mjs",
    "define-step": "node scripts/define-step.mjs",
    "request-revision": "node scripts/request-revision.mjs",
    "approve-step": "node scripts/approve-step.mjs",
    "add-feedback": "node scripts/add-feedback.mjs",
    "issue-task": "node scripts/issue-task.mjs",
    "prepare-workspace": "node scripts/prepare-workspace.mjs",
    "workspace-status": "node scripts/workspace-status.mjs",
    "submit-worker": "node scripts/submit-worker.mjs",
    "worker-status": "node scripts/worker-status.mjs",
    "collect-worker": "node scripts/collect-worker.mjs",
    "complete-task": "node scripts/complete-task.mjs",
    "check-store-read": "npm run gen && node scripts/check-store-read.mjs",
    "check-gitignore": "node scripts/check-gitignore.mjs",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run gen",
    "test": "vitest run",
    "execution": "node scripts/execution.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
